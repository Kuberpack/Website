# Gmail account used to send inquiry/RFQ emails from the website.
# Must be a Gmail address with 2-Step Verification enabled, using an
# App Password (NOT your normal Gmail password).
# Create one at: https://myaccount.google.com/apppasswords
GMAIL_USER=yourname@gmail.com
GMAIL_APP_PASSWORD=your16charapppassword

# Optional: where inquiries are delivered. Defaults to GMAIL_USER if unset.
CONTACT_TO_EMAIL=kuberpack@gmail.com
